# The LLM (D-002). Pick a provider and paste its key; that's all.
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key
# Gemini's free tier instead (about 20 requests a day per model, roughly 5 questions):
# LLM_PROVIDER=gemini
# Optional overrides for any other OpenAI-compatible API or model:
# LLM_BASE_URL=
# LLM_MODEL=
